{
  "name": "kxco-verify",
  "version": "1.3.3",
  "description": "Free, browser-safe verifier for KXCO ML-DSA-65 post-quantum signatures, with no KXCO server in the trust path. An auditor, regulator or counterparty confirms a signature from the artefact alone, years later, and can check the key is still live against the on-chain registry.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "dilithium",
    "nist",
    "fips-204",
    "verification",
    "attestation",
    "verify",
    "kxco-post-quantum",
    "browser",
    "browser-safe",
    "supply-chain",
    "deploy-attestation",
    "provenance",
    "manifest-verification",
    "pqc-migration",
    "digital-signature",
    "signature-verification",
    "non-repudiation",
    "tamper-evident",
    "offline-verification",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://verify.kxco.ai",
  "funding": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-verify.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-verify/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./parse": {
      "types": "./src/parse.d.ts",
      "import": "./src/parse.js"
    },
    "./verify": {
      "types": "./src/verify.d.ts",
      "import": "./src/verify.js"
    },
    "./fetch": {
      "types": "./src/fetch.d.ts",
      "import": "./src/fetch.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/parse.test.js test/verify.test.js test/fetch.test.js test/index.test.js test/property.test.js",
    "test:cov": "node --test --experimental-test-coverage test/parse.test.js test/verify.test.js test/fetch.test.js test/index.test.js",
    "smoke": "node scripts/smoke.js",
    "lint": "node -c src/index.js && node -c src/parse.js && node -c src/verify.js && node -c src/fetch.js"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "bin": {
    "kxco-verify": "bin/kxco-verify.js"
  },
  "peerDependencies": {
    "kxco-pq-network": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "kxco-pq-network": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "kxco-post-quantum": "1.7.8"
  }
}
